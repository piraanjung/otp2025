<script>
      $(document).ready(function() {
            $(".minus").click(function() {
                var $input = $(this).parent().find("input");
                var count = parseInt($input.val()) - 1;
                count = count < 1 ? 1 : count;
                $input.val(count);
                $input.change();
                changeQtyText(count)
                return false;
            });
            $(".plus").click(function() {
                var $input = $(this).parent().find("input");
                var count =parseInt($input.val()) + 1;
                $input.val(count);
                $input.change();
                changeQtyText(count)
                return false;
            });
        });

        function changeQtyText(count){
            $('.qty').html(count)
        }
</script>
