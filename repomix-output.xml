        Machine::where('machine_id', $request->machine_id)->update([
            'pending_command' => $request->code, // 0=ACCEPT, 1=REJECT
            'has_new_object' => 2, // อาจเปลี่ยนสถานะเพื่อบอกว่า 'กำลังรอ ESP มารับคำสั่ง'
